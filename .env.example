# Engine for `pnpm start` (watch | paper | trade). Explicit CLI commands still override.
MODE=paper

# Unique id for this process (isolates bot.portfolios / bot.trades / market.signals).
BOT_ID=local

# TimescaleDB / Postgres connection string.
# Local compose: docker compose up -d (`sslmode=prefer` lets dbmate connect without TLS)
# Hosted databases that require TLS should use sslmode=require
DATABASE_URL=postgres://speculator:speculator@localhost:5432/speculator?sslmode=prefer

# pg.Pool (low defaults; uncomment to override)
# DATABASE_POOL_MAX=2
# DATABASE_POOL_MIN=0
# DATABASE_POOL_IDLE_TIMEOUT_MS=1000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# bollinger = 15m BB(16,1.5) reclaim; RSI(14)<30; trend EMA50; ADX<=32; min band→mid 0.4%; exit at mid; ATR 2x/2.5x; cooldown 4
# grid      = 15m ATR14×1.5 grid; trend EMA20; ADX<=30; reanchor 20; BUY reclaim; SELL at entry+spacing; ATR 2.5x/3x; cooldown 1
STRATEGY=bollinger

# Higher-timeframe bars for StrategyManager (200-EMA / ADX / ATR / trend). Default 4h.
# 1d is slower and less useful on 24/7 Solana; keep as an opt-in.
HTF=4h

# From https://portal.jup.ag/ — recommended for stable quotes
JUPITER_API_KEY=

# Comma-separated pairs resolved via solana.tokens + solana.pools (default SOL/USDC)
WATCHLIST=SOL/USDC

# How often to poll candles + quote (ms)
POLL_INTERVAL_MS=60000

# Starting virtual USDC balance for paper mode (used only when this BOT_ID has no paper rows)
PAPER_CASH_USDC=1000

# Live trading (`pnpm trade`) — keep the keypair file outside this repo. Never commit it.
# WALLET_KEYPAIR_PATH=/home/YOU/.config/solana/id.json
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SLIPPAGE_BPS=50
# LIVE_SOL_RESERVE_SOL=0.05

# Optional Telegram alerts + commands (/start, /report, /market, /chart, /portfolio). Both required to enable.
# Create a bot via @BotFather, then set your chat id (e.g. from @userinfobot).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
