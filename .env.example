# ema-rsi   = 4h EMA 12/26; trend EMA 50; ADX>=20; RSI buy [40,60), sell RSI>45; ATR stop 2x / trail 2.5x; cooldown 2
# bollinger = 15m BB(20,2) reclaim; trend EMA40; ADX<=24; min band→mid 0.4%; exit at mid; ATR 2x/2.5x; cooldown 4
# grid      = 15m ATR14×1.5 grid; trend EMA20; ADX<=30; reanchor 20; BUY reclaim; SELL at entry+spacing; ATR 2.5x/3x; cooldown 1
STRATEGY=ema-rsi

# From https://portal.jup.ag/ — recommended for stable quotes
JUPITER_API_KEY=

# Comma-separated pairs resolved via solana.tokens (default SOL/USDC)
WATCHLIST=SOL/USDC

# How often to poll candles + quote (ms)
POLL_INTERVAL_MS=60000

# Starting virtual USDC balance for paper mode (used only when DuckDB has no paper portfolio rows)
PAPER_CASH_USDC=1000

# Optional Telegram alerts + commands (/start, /report, /chart, /portfolio). Both required to enable.
# Create a bot via @BotFather, then set your chat id (e.g. from @userinfobot).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# DuckDB operating mode (default: standalone — local file, no network).
#   standalone  Open data/speculator.duckdb directly (default).
#   server      Open the file AND expose it via the Quack protocol (pnpm database or any command).
#   client      Connect to a remote Quack server; no local file is opened.
# DUCKDB_MODE=standalone

# Quack server URI.
#   server mode: bind address (e.g. quack:0.0.0.0:9494 to listen on all interfaces).
#   client mode: connect address (e.g. quack:db-host:9494).
# Default port is 9494. Use allow_other_hostname automatically for non-localhost addresses.
# DUCKDB_URL=quack:localhost

# Quack auth token — required when DUCKDB_MODE is server or client.
# Must not contain single quotes. Choose a strong random string.
# DUCKDB_SECRET=

# Use TLS for quack_query (client mode). Default false passes disable_ssl => true.
# DUCKDB_SSL=false
