[Unit]
Description=Speculator Solana trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=speculator
WorkingDirectory=/opt/speculator

# Loads JUPITER_API_KEY, TELEGRAM_*, STRATEGY, MODE, etc.
EnvironmentFile=/opt/speculator/.env

ExecStart=/usr/bin/node /opt/speculator/dist/index.js

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bot

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
