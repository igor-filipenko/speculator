[Unit]
Description=Speculator Solana paper/signal bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace with the Linux user that owns the clone
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/speculator

# Loads JUPITER_API_KEY, TELEGRAM_*, STRATEGY, etc.
EnvironmentFile=/home/YOUR_USER/speculator/.env

# paper = virtual portfolio; use `pnpm watch` for signals only
ExecStart=/usr/bin/pnpm paper

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=speculator

# Hardening (safe for a non-root bot process)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
