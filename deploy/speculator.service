[Unit]
Description=Speculator Solana trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace with the Linux user that owns the runtime directory
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/opt/speculator

# Loads JUPITER_API_KEY, TELEGRAM_*, STRATEGY, etc.
EnvironmentFile=/opt/speculator/.env

# Built runtime (deployed via README one-shot command)
ExecStart=/usr/bin/node /opt/speculator/dist/index.js paper

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=speculator

# Hardening (safe for a non-root bot process)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
