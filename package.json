{
  "name": "speculator",
  "version": "0.1.0",
  "private": true,
  "description": "Solana swing/intraday signal bot with Jupiter paper trading",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "watch": "tsx src/index.ts watch",
    "paper": "tsx src/index.ts paper",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "build": "tsc -p tsconfig.build.json",
    "install-runtime": "node scripts/install-runtime.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "grammy": "^1.45.1",
    "ts-pattern": "5.9.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
