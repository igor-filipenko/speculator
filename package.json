{
  "name": "speculator",
  "version": "0.1.0",
  "private": true,
  "description": "Solana trading bot",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "watch": "tsx src/index.ts watch",
    "paper": "tsx src/index.ts paper",
    "trade": "tsx src/index.ts trade",
    "wallet": "tsx src/index.ts wallet",
    "backtest": "tsx src/index.ts backtest",
    "database": "tsx src/index.ts database",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'",
    "build": "tsc -p tsconfig.build.json",
    "install-runtime": "node scripts/install-runtime.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@duckdb/node-api",
      "canvas",
      "esbuild"
    ]
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@neabyte/candlestick-cli": "1.1.2",
    "@resvg/resvg-js": "2.6.2",
    "@solana/web3.js": "1.98.4",
    "dotenv": "^16.6.1",
    "grammy": "^1.45.1",
    "ts-pattern": "5.9.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.15",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.8.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  }
}
