{
  "name": "speculator",
  "version": "0.1.0",
  "private": true,
  "description": "Solana swing/intraday signal bot with Jupiter paper trading",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "watch": "tsx src/index.ts watch",
    "paper": "tsx src/index.ts paper",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "grammy": "^1.45.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
