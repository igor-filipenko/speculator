{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "VITE_SKIP_TELEGRAM_AUTH=1 vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
